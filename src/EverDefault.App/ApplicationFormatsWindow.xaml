<Window x:Class="EverDefault.App.ApplicationFormatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入应用支持的格式" Height="580" Width="640"
        MinHeight="440" MinWidth="520"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="选择一个应用并扫描，EverDefault 会自动找出它为哪些文件类型注册了打开方式，并按 ProgId 分组创建规则（同一分组共用一个 ProgId，因此每组一条规则）。" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <ComboBox x:Name="AppBox" Width="400" DisplayMemberPath="DisplayName"
                      ToolTip="检测到的已注册应用。" />
            <Button Content="浏览..." Width="72" Margin="6,0,0,0" Click="OnBrowse"
                    ToolTip="列表里没有？直接选择应用的 exe。" />
            <Button x:Name="ScanButton" Content="扫描" Width="64" Margin="6,0,0,0" Click="OnScan" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Style="{StaticResource HintText}"
                       Margin="0,0,0,6" Text="请选择应用后点“扫描”。" />
            <ListBox x:Name="GroupList" SelectionMode="Extended">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding ProgId}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ExtensionsText}" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="全选" Width="72" Margin="4,0" Click="OnSelectAll" />
            <Button Content="全不选" Width="72" Margin="4,0" Click="OnSelectNone" />
            <Button x:Name="ImportButton" Content="导入选中" Width="100" Margin="12,0,4,0"
                    IsEnabled="False" IsDefault="True" Click="OnImport" />
            <Button Content="取消" Width="80" Margin="4,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
