<local:DialogWindow x:Class="EverDefault.App.ApplicationFormatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EverDefault.App"
        Title="导入应用支持的格式" Height="580" Width="640"
        MinHeight="440" MinWidth="520"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource HintText}"
                   Text="选择一个应用并扫描，EverDefault 会自动找出它为哪些文件类型注册了打开方式，并按 ProgId 分组。勾选需要的分组后会合并为一条规则，每个扩展名各自记录对应的 ProgId。" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <ComboBox x:Name="AppBox" Width="400" DisplayMemberPath="DisplayName"
                      ToolTip="检测到的已注册应用。" />
            <Button Content="浏览..." Width="72" Margin="6,0,0,0" Click="OnBrowse"
                    ToolTip="列表里没有？直接选择应用的 exe。" />
            <Button x:Name="ScanButton" Content="扫描" Width="64" Margin="6,0,0,0" Click="OnScan" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" VerticalAlignment="Center"
                           Margin="0,0,160,0" Text="请选择应用后点“扫描”。" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="全选" Width="64" Margin="0,0,8,0" Click="OnSelectAll" />
                    <Button Content="全不选" Width="64" Click="OnSelectNone" />
                </StackPanel>
            </Grid>
            <ListBox x:Name="GroupList" SelectionMode="Extended">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding ProgId}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ExtensionsText}" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ImportButton" Content="合并导入" Style="{StaticResource PrimaryButton}"
                    Width="100" Margin="0,0,8,0" IsEnabled="False" IsDefault="True" Click="OnImport" />
            <Button Content="取消" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</local:DialogWindow>
