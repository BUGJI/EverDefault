<Window x:Class="EverDefault.App.ChangeAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="换应用" Height="540" Width="640"
        MinHeight="420" MinWidth="520"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <ComboBox x:Name="AppBox" Width="360" DisplayMemberPath="DisplayName"
                      ToolTip="检测到的已注册应用。" />
            <Button Content="浏览..." Width="72" Margin="6,0,0,0" Click="OnBrowse" />
            <Button x:Name="ScanButton" Content="扫描" Width="64" Margin="6,0,0,0" Click="OnScan" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource HintText}"
                   Margin="0,8,0,6" Text="选择新应用后点“扫描”。" />

        <ListBox x:Name="PreviewList" Grid.Row="3">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="{Binding Extension}" FontWeight="SemiBold" Width="120" />
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ApplyButton" Content="应用" Width="100" Margin="4,0"
                    IsEnabled="False" IsDefault="True" Click="OnApply" />
            <Button Content="取消" Width="80" Margin="4,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
