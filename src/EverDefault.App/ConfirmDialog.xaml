<local:DialogWindow x:Class="EverDefault.App.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EverDefault.App"
        Title="确认" Width="460" MaxHeight="560" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Style="{StaticResource DialogWindowStyle}">
    <StackPanel Margin="20,16,20,18">
        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeBody}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SubtleButton}"
                    MinWidth="84" IsCancel="True" Click="OnCancel" />
            <Button x:Name="ConfirmButton" Content="确定" Style="{StaticResource PrimaryButton}"
                    MinWidth="84" Margin="8,0,0,0" Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</local:DialogWindow>
