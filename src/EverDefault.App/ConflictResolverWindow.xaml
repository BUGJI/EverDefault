<local:DialogWindow x:Class="EverDefault.App.ConflictResolverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EverDefault.App"
        Title="处理保护冲突" Height="520" Width="680"
        MinHeight="360" MinWidth="520"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource HintText}"
                   Text="下面这些保护项互相冲突，EverDefault 暂时不会执行它们。停用其中一条即可恢复。" />

        <ListBox x:Name="RuleList" Grid.Row="1" Margin="0,12,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="停用这一条" Style="{StaticResource DangerButton}"
                                Width="104" Margin="10,0,0,0" Click="OnDisable" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" Width="82" IsCancel="True" />
        </StackPanel>
    </Grid>
</local:DialogWindow>
