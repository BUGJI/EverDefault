<UserControl x:Class="EverDefault.App.BasicConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EverDefault.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <Border x:Name="ExistingHint" Style="{StaticResource CardPanel}" Visibility="Collapsed"
                    Margin="0,0,0,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="前往高级配置" MinWidth="108" Margin="10,0,0,0"
                            Click="OnGoAdvanced" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="这条保护项包含高级设置。基础配置只能做简单勾选，建议在“高级配置”里修改。" />
                </DockPanel>
            </Border>

            <!-- Default application -->
            <StackPanel x:Name="AppSection">
                <TextBlock Text="要保护什么" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="勾选文件类型或链接。勾选后，其他程序试图修改默认打开方式时会被自动改回。" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="CurrentDefaultRadio" Content="保护当前默认程序"
                                 IsChecked="True" Checked="OnModeChanged" />
                    <RadioButton x:Name="SpecificAppRadio" Content="指定一个程序"
                                 Margin="18,0,0,0" Checked="OnModeChanged" />
                </StackPanel>

                <StackPanel x:Name="SpecificPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="AppBox" Width="300" DisplayMemberPath="DisplayName"
                                  IsEditable="True" IsTextSearchEnabled="True"
                                  ToolTip="已注册的应用，也可以直接输入名称搜索。" />
                        <Button Content="浏览..." MinWidth="72" Margin="6,0,0,0" Click="OnBrowse" />
                        <Button x:Name="ScanAppButton" Content="扫描支持的格式" MinWidth="120"
                                Margin="6,0,0,0" Click="OnScanApp" />
                    </StackPanel>
                    <TextBlock x:Name="AppStatusText" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                </StackPanel>

                <TextBlock Text="文件类型" Style="{StaticResource SectionHeader}" Margin="0,14,0,4" />
                <WrapPanel x:Name="CategoryPanel" Margin="0,0,0,6" />
                <TextBox x:Name="SearchBox" Margin="0,0,0,6"
                         ToolTip="输入 pdf、png、视频等关键词过滤。"
                         TextChanged="OnSearchChanged" />
                <ListBox x:Name="ExtensionList" MaxHeight="240" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Click="OnExtensionClicked" Margin="0,1">
                                <TextBlock Text="{Binding Label}" />
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="链接类型" Style="{StaticResource SectionHeader}" Margin="0,14,0,4" />
                <WrapPanel x:Name="ProtocolPanel">
                    <CheckBox x:Name="HttpCheck" Content="网页链接（http/https）" Margin="0,0,20,0"
                              Click="OnProtocolClicked" />
                    <CheckBox x:Name="MailtoCheck" Content="邮件链接（mailto）"
                              Click="OnProtocolClicked" />
                </WrapPanel>

                <local:ProtectionPreview x:Name="Preview" Margin="0,14,0,0" />
            </StackPanel>

            <!-- This PC -->
            <StackPanel x:Name="NameSpaceSection" Visibility="Collapsed">
                <TextBlock Text="整理此电脑" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="扫描“此电脑”和桌面上多出来的图标，勾选后一键移除。" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="ScanNameSpaceButton" Content="扫描此电脑" MinWidth="100" Click="OnScanNameSpace" />
                    <TextBox x:Name="NsSearchBox" Width="220" Margin="8,0,0,0"
                             ToolTip="按名称或路径过滤。" TextChanged="OnNsSearchChanged" />
                    <Button Content="全选" MinWidth="64" Margin="8,0,0,0" Click="OnNsSelectAll" />
                    <Button Content="全不选" MinWidth="72" Margin="6,0,0,0" Click="OnNsSelectNone" />
                </StackPanel>

                <TextBlock x:Name="NsStatusText" Style="{StaticResource HintText}" Margin="0,8,0,6" />
                <ListBox x:Name="NsList" MaxHeight="260"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Click="OnNsClicked" Margin="0,2">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <local:ProtectionPreview x:Name="NsPreview" Margin="0,14,0,0" />
            </StackPanel>

            <!-- System settings -->
            <StackPanel x:Name="CustomSection" Visibility="Collapsed">
                <TextBlock Text="保护系统设置" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="勾选想让 EverDefault 替你守住的设置。其它注册表项请到“高级配置”填写。" />

                <ItemsControl x:Name="PresetList" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Click="OnPresetClicked" Margin="0,5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontSizeCaption}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <local:ProtectionPreview x:Name="CustomPreview" Margin="0,14,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
