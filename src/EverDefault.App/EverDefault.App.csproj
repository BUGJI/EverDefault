<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\logo.ico" />
    <None Remove="Assets\logo.png" />
    <Resource Include="Assets\logo.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EverDefault.Core\EverDefault.Core.csproj" />
    <ProjectReference Include="..\EverDefault.Ipc\EverDefault.Ipc.csproj" />
    <ProjectReference Include="..\EverDefault.Registry\EverDefault.Registry.csproj" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
