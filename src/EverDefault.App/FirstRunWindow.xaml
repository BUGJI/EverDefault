<local:DialogWindow x:Class="EverDefault.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EverDefault.App"
        Title="欢迎使用 EverDefault" Height="660" Width="800"
        MinHeight="500" MinWidth="660"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="48" Height="48" CornerRadius="{StaticResource RadiusLarge}"
                    Background="{DynamicResource AccentSubtleBrush}">
                <Image Width="30" Height="30" Stretch="Uniform"
                       Source="pack://application:,,,/EverDefault.App;component/Assets/logo.png" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="欢迎使用 EverDefault" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,5,0,0"
                           Text="选几项你现在正在用的默认程序，EverDefault 会帮你守住它们。以后有程序想偷偷改掉，会自动改回来。" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="建议保护这些" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10"
                           Text="已经按你当前的选择预填好了，取消勾选可以跳过。" />

                <ItemsControl x:Name="RecommendationList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,8" Padding="12">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding Available}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSection}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource CardPanel}" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="开机自动保护" Style="{StaticResource SectionHeader}" />
                        <CheckBox x:Name="StartupCheck" Content="随系统启动，登录后自动保护"
                                  Margin="0,6,0,0" />
                        <TextBlock x:Name="ServiceText" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                        <Button x:Name="StartServiceButton" Content="启动后台保护"
                                Style="{StaticResource SubtleButton}" MinWidth="118"
                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                Visibility="Collapsed" Click="OnStartService" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,190,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartButton" Content="开始保护" Style="{StaticResource PrimaryButton}"
                        Width="112" Margin="0,0,8,0" IsDefault="True" Click="OnStart" />
                <Button x:Name="SkipButton" Content="跳过" Style="{StaticResource SubtleButton}"
                        Width="80" IsCancel="True" Click="OnSkip" />
            </StackPanel>
        </Grid>
    </Grid>
</local:DialogWindow>
