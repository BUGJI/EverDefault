<Window x:Class="EverDefault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EverDefault.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EverDefault - 保护你的默认设置" Height="680" Width="1060"
        MinHeight="560" MinWidth="900"
        Icon="pack://application:,,,/EverDefault.App;component/Assets/logo.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        StateChanged="OnWindowStateChanged"
        Loaded="OnLoaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource NavTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="{StaticResource RadiusMedium}" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5"
                                        Background="Transparent" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Margin="-8,0,0,0" />
                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavSubItem" TargetType="RadioButton" BasedOn="{StaticResource NavItem}">
            <Setter Property="Padding" Value="30,6" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static local:IconFontSupport.IsAvailable}}" Value="False">
                    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                    <Setter Property="Foreground" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static local:IconFontSupport.IsAvailable}}" Value="False">
                    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                    <Setter Property="Padding" Value="2,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFC50F1F" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="46" Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="{StaticResource RadiusMedium}"
                            Background="{DynamicResource AccentSubtleBrush}">
                        <Image Source="pack://application:,,,/EverDefault.App;component/Assets/logo.png"
                               Width="18" Height="18" Stretch="Uniform" />
                    </Border>
                    <TextBlock DockPanel.Dock="Left" Text="EverDefault" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                    <Border DockPanel.Dock="Left" Width="1" Height="18"
                            Background="{DynamicResource BorderSoftBrush}" Margin="14,0" />
                    <Ellipse DockPanel.Dock="Left" x:Name="StatusDot" Width="8" Height="8"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource TextMutedBrush}" Margin="0,0,7,0" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                               Text="正在连接后台保护..." />
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button x:Name="ExportButton" Style="{StaticResource AdaptiveIconButton}"
                            Content="{DynamicResource IconExportContent}"
                            VerticalAlignment="Center" Margin="0,0,2,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="导出备份"
                            ToolTip="把当前全部保护导出为 JSON 备份。" Visibility="Collapsed"
                            Click="OnExport" />
                    <Button x:Name="ImportButton" Style="{StaticResource AdaptiveIconButton}"
                            Content="{DynamicResource IconImportContent}"
                            VerticalAlignment="Center" Margin="0,0,2,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="导入备份"
                            ToolTip="从 JSON 备份追加导入保护。" Visibility="Collapsed"
                            Click="OnImport" />
                    <Border Width="1" Height="18" Background="{DynamicResource BorderSoftBrush}"
                            VerticalAlignment="Center" Margin="6,0" />
                    <Button Content="{DynamicResource IconRefreshContent}" Style="{StaticResource AdaptiveIconButton}"
                            VerticalAlignment="Center" Margin="0,0,6,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="刷新状态"
                            ToolTip="刷新状态" Click="OnRefresh" />
                    <Button Content="{DynamicResource WindowMinimizeContent}" Style="{StaticResource WindowButton}"
                            AutomationProperties.Name="最小化"
                            ToolTip="最小化" Click="OnMinimize" />
                    <Button x:Name="MaximizeButton" Content="{DynamicResource WindowMaximizeContent}"
                            Style="{StaticResource WindowButton}"
                            AutomationProperties.Name="最大化"
                            ToolTip="最大化" Click="OnMaximizeRestore" />
                    <Button Content="{DynamicResource WindowCloseContent}" Style="{StaticResource WindowCloseButton}"
                            AutomationProperties.Name="关闭"
                            ToolTip="关闭" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,12">
                            <TextBlock Text="浏览" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="10,2,0,6" />

                            <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}"
                                         GroupName="nav" Tag="home" Checked="OnNavChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="主页" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavProtection" Style="{StaticResource NavItem}"
                                         GroupName="nav" Tag="protection" Checked="OnNavChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="我的保护" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavActivity" Style="{StaticResource NavItem}"
                                         GroupName="nav" Tag="activity" Checked="OnNavChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="活动" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}"
                                         GroupName="nav" Tag="settings" Checked="OnNavChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="设置" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </RadioButton>

                            <TextBlock x:Name="AdvancedHeader" Text="高级规则"
                                       Margin="10,16,0,6" Foreground="{DynamicResource TextMutedBrush}"
                                       FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Visibility="Collapsed" />
                            <RadioButton x:Name="NavDefaultApp" Content="默认应用"
                                         Style="{StaticResource NavSubItem}" GroupName="nav"
                                         Tag="rule:DefaultApp" Checked="OnNavChecked" Visibility="Collapsed" />
                            <RadioButton x:Name="NavNameSpace" Content="此电脑"
                                         Style="{StaticResource NavSubItem}" GroupName="nav"
                                         Tag="rule:NameSpace" Checked="OnNavChecked" Visibility="Collapsed" />
                            <RadioButton x:Name="NavCustom" Content="自定义注册表"
                                         Style="{StaticResource NavSubItem}" GroupName="nav"
                                         Tag="rule:CustomRegistry" Checked="OnNavChecked" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="0,1,0,0" Padding="8,8">
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}"
                                     GroupName="nav" Tag="about" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="关于" Style="{StaticResource NavLabel}" />
                            </StackPanel>
                        </RadioButton>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" x:Name="PageHost" Margin="20,18" />
        </Grid>

        <Border x:Name="ToastBanner" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="20"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24" MaxWidth="460" Padding="14,10"
                CornerRadius="{StaticResource RadiusCard}"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeBody}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>
        </Grid>
    </Border>
</Window>
