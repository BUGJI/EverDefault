<Window x:Class="EverDefault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EverDefault - 注册表守护" Height="720" Width="1120"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <Window.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FF333333" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFEDEDED" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavSubItem" TargetType="RadioButton" BasedOn="{StaticResource NavItem}">
            <Setter Property="Padding" Value="26,7" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFF7F7F7" BorderBrush="#FFE0E0E0"
                BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontWeight="Bold" TextTrimming="CharacterEllipsis" Text="正在连接服务..." />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="MonitoringCheck" Content="启用监控" VerticalAlignment="Center"
                              Margin="8,0" Click="OnMonitoringChanged"
                              ToolTip="开启后，后台服务会按规则监控并在必要时还原注册表。" />
                    <Button Content="刷新" Width="64" Margin="4,0" Click="OnRefresh" />
                    <Button Content="导出" Width="64" Margin="4,0" Click="OnExport"
                            ToolTip="把当前全部规则导出为 JSON 备份。" />
                    <Button Content="导入" Width="64" Margin="4,0" Click="OnImport"
                            ToolTip="从 JSON 追加导入规则（不会覆盖已有规则）。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFF7F7F7" BorderBrush="#FFE0E0E0"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="8,10">
                    <RadioButton x:Name="NavHome" Content="主页" Style="{StaticResource NavItem}"
                                 GroupName="nav" Tag="home" Checked="OnNavChecked" />
                    <TextBlock Text="规则" Margin="12,14,0,4" Foreground="#FF888888"
                               FontWeight="Bold" FontSize="12" />
                    <RadioButton x:Name="NavDefaultApp" Content="默认应用"
                                 Style="{StaticResource NavSubItem}" GroupName="nav"
                                 Tag="rule:DefaultApp" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavNameSpace" Content="此电脑"
                                 Style="{StaticResource NavSubItem}" GroupName="nav"
                                 Tag="rule:NameSpace" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavCustom" Content="自定义注册表"
                                 Style="{StaticResource NavSubItem}" GroupName="nav"
                                 Tag="rule:CustomRegistry" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavLog" Content="日志" Style="{StaticResource NavItem}"
                                 GroupName="nav" Tag="log" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavSettings" Content="设置" Style="{StaticResource NavItem}"
                                 GroupName="nav" Tag="settings" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavAbout" Content="关于" Style="{StaticResource NavItem}"
                                 GroupName="nav" Tag="about" Checked="OnNavChecked" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" x:Name="PageHost" Margin="16,14" />
        </Grid>
    </Grid>
</Window>
