<UserControl x:Class="EverDefault.App.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SegmentButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="{StaticResource RadiusMedium}" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="活动" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="Hint" Style="{StaticResource PageHint}"
                       Text="EverDefault 每次改回设置都会记在这里。" />

            <DockPanel Margin="0,12,0,0">
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="清空记录"
                        Style="{StaticResource SubtleButton}" MinWidth="88"
                        Margin="8,0,0,0" Click="OnClear"
                        ToolTip="删除全部活动记录，不影响保护规则。" />

                <Grid Width="220" DockPanel.Dock="Left" Margin="0,0,8,0">
                    <TextBox x:Name="SearchBox" Padding="6,4,26,4" TextChanged="OnSearchChanged"
                             AutomationProperties.Name="搜索活动记录"
                             ToolTip="按标题或详情搜索。" />
                    <TextBlock x:Name="SearchPlaceholder" Text="搜索活动"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsHitTestVisible="False" />
                    <Button x:Name="ClearSearchButton" Content="×" Style="{StaticResource SubtleButton}"
                            Width="22" Height="22" MinHeight="0" Padding="0" FontSize="14"
                            FontFamily="{StaticResource AppFontFamily}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0" Visibility="Collapsed"
                            AutomationProperties.Name="清除搜索" ToolTip="清除搜索"
                            Click="OnClearSearch" />
                </Grid>

                <Border HorizontalAlignment="Left" Padding="3"
                        CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="AllButton" Content="全部" Style="{StaticResource SegmentButton}"
                                      Tag="all" Click="OnFilter" />
                        <ToggleButton x:Name="BlockedButton" Content="已拦截" Style="{StaticResource SegmentButton}"
                                      Tag="blocked" Click="OnFilter" />
                        <ToggleButton x:Name="FailedButton" Content="需要处理" Style="{StaticResource SegmentButton}"
                                      Tag="failed" Click="OnFilter" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="EmptyHint" Style="{StaticResource HintText}" Margin="0,8,0,8" />

            <ListBox x:Name="ActivityList" Grid.Row="1"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource PlainListItem}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     Focusable="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="IconChip" Width="30" Height="30" CornerRadius="{StaticResource RadiusCard}"
                                            Style="{StaticResource IconTile}"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource ControlBackgroundBrush}">
                                        <TextBlock x:Name="IconGlyph" Text="{Binding Glyph}"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="14" Margin="0,1,0,0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSection}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                        <Expander Header="详情" Margin="0,6,0,0"
                                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                  FontSize="{StaticResource FontSizeCaption}">
                                            <Expander.Style>
                                                <Style TargetType="Expander">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRawDetail}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Expander.Style>
                                            <TextBlock Text="{Binding RawDetail}" FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </Expander>
                                        <Button Content="调整保护" Style="{StaticResource SubtleButton}"
                                                MinWidth="88" Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                IsEnabled="{Binding CanAdjust}" Click="OnAdjust" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,2,0,0" />
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                    <Setter TargetName="IconChip" Property="Background"
                                            Value="{DynamicResource SuccessSubtleBrush}" />
                                    <Setter TargetName="IconGlyph" Property="Foreground"
                                            Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter TargetName="IconChip" Property="Background"
                                            Value="{DynamicResource DangerSubtleBrush}" />
                                    <Setter TargetName="IconGlyph" Property="Foreground"
                                            Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
