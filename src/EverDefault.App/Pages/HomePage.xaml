<UserControl x:Class="EverDefault.App.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="主页" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="EverDefault 会锁定你选择的东西，被其他软件改动后自动改回。" Style="{StaticResource HintText}" Margin="0,4,0,0" />

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="ModeButton" DockPanel.Dock="Right" Margin="12,0,0,0"
                                Padding="14,6" FontWeight="Bold" Cursor="Hand" Click="OnModeClick"
                                ToolTip="点击切换运行模式：用户模式会以管理员权限安装为服务并重启。" />
                        <TextBlock x:Name="StatusTitle" FontSize="15" FontWeight="Bold"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                    <TextBlock x:Name="ActionStatus" Style="{StaticResource HintText}" Margin="0,6,0,0" />

                    <TextBlock Text="自本次服务启动以来" Style="{StaticResource SectionHeader}" Margin="0,16,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="已记录" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                            <TextBlock x:Name="ObservedText" FontSize="24" FontWeight="Bold" Text="0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="已拦截" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                            <TextBlock x:Name="BlockedText" FontSize="24" FontWeight="Bold" Text="0"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="拦截失败" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                            <TextBlock x:Name="FailedText" FontSize="24" FontWeight="Bold" Text="0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ConflictText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,12,0,0" />

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="三步上手" Style="{StaticResource SectionHeader}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="1. 打开软件即自动连接服务：已安装则启动服务模式，未安装则以用户模式临时运行（无需管理员）。&#10;&#10;2. 创建规则：到左侧“规则”分类里点『新建』，填好目标后保存；也可以用『测试规则』先跑通流程。&#10;&#10;3. 验证：用 regedit 改动被保护的键，几秒后到“日志”页即可看到记录与处理结果。&#10;&#10;想长期后台守护，点上方“用户模式”按钮即可安装为服务模式。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
