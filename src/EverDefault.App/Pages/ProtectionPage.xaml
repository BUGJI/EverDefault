<UserControl x:Class="EverDefault.App.ProtectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="我的保护" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="Hint" Style="{StaticResource PageHint}"
                       Text="这里是你正在保护的项目。关掉开关即可暂时停用，点“调整”可以改保护范围。" />

            <Border x:Name="OfflineBanner" Style="{StaticResource CardPanel}" Margin="0,10,0,0"
                    Background="{DynamicResource WarningSubtleBrush}"
                    BorderBrush="{DynamicResource WarningBrush}" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="启动后台保护" MinWidth="118"
                            Margin="12,0,0,0" Click="OnStartService" />
                    <TextBlock x:Name="OfflineText" Text="后台保护未运行，暂时无法读取或修改保护项。"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningBrush}" />
                </DockPanel>
            </Border>

            <WrapPanel Margin="0,14,0,0">
                <Button x:Name="ProtectCurrentButton" Content="保护当前默认程序"
                        Style="{StaticResource PrimaryButton}" MinWidth="156" Margin="0,0,8,6"
                        Click="OnProtectCurrent" />
                <Button x:Name="AddAppButton" Content="添加默认应用保护" MinWidth="150"
                        Margin="0,0,8,6" Click="OnAddDefaultApp" />
                <Button x:Name="AddFileTypeButton" Style="{StaticResource SubtleButton}"
                        Content="保护某个文件类型" MinWidth="136" Margin="0,0,8,6" Click="OnAddFileType" />
                <Button x:Name="AddNameSpaceButton" Style="{StaticResource SubtleButton}"
                        Content="整理此电脑" MinWidth="106" Margin="0,0,8,6" Click="OnAddNameSpace" />
                <Button x:Name="AddCustomButton" Style="{StaticResource SubtleButton}"
                        Content="保护系统设置" MinWidth="106" Margin="0,0,8,6" Click="OnAddCustom" />
            </WrapPanel>

            <WrapPanel Margin="0,2,0,0">
                <Grid Width="220" Margin="0,0,8,6">
                    <TextBox x:Name="SearchBox" Padding="6,4" TextChanged="OnSearchChanged"
                             AutomationProperties.Name="搜索保护项"
                             ToolTip="按应用名或保护范围搜索。" />
                    <TextBlock x:Name="SearchPlaceholder" Text="搜索应用或文件类型"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsHitTestVisible="False" />
                </Grid>
                <ComboBox x:Name="FilterBox" Width="110" Margin="0,0,8,6"
                          SelectionChanged="OnFilterChanged"
                          AutomationProperties.Name="筛选保护状态">
                    <ComboBoxItem Content="全部" Tag="all" />
                    <ComboBoxItem Content="保护中" Tag="active" />
                    <ComboBoxItem Content="已暂停" Tag="paused" />
                    <ComboBoxItem Content="已停用" Tag="disabled" />
                </ComboBox>
                <Button x:Name="PauseAllButton" Style="{StaticResource SubtleButton}"
                        Content="全部暂停 1 小时" MinWidth="120" Margin="0,0,8,6"
                        Click="OnPauseAll" />
                <Button x:Name="ResumeAllButton" Style="{StaticResource SubtleButton}"
                        Content="全部恢复" MinWidth="88" Margin="0,0,8,6"
                        Click="OnResumeAll" />
            </WrapPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="EmptyHint" Style="{StaticResource HintText}" Margin="0,8,0,8" />

                <ItemsControl x:Name="ProtectionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="44" Height="44" CornerRadius="{StaticResource RadiusLarge}"
                                            Style="{StaticResource IconTile}"
                                            Background="{DynamicResource ControlBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding Glyph}"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="19" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border x:Name="StatusChip" CornerRadius="10" Padding="8,2"
                                                    Background="{DynamicResource SuccessSubtleBrush}"
                                                    ToolTip="{Binding StatusText}">
                                                <TextBlock x:Name="StatusLabel" Text="保护中" FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource SuccessBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding ModuleText}" FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                                  AutomationProperties.Name="启用或停用这项保护"
                                                  ToolTip="启用或停用这项保护"
                                                  Click="OnToggle" />
                                        <Button Content="调整" MinWidth="64" Margin="0,0,8,0" Click="OnEdit" />
                                        <Button Style="{StaticResource AdaptiveIconButton}"
                                                Content="{DynamicResource IconMoreContent}"
                                                AutomationProperties.Name="更多操作"
                                                ToolTip="更多操作" Click="OnMore">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{Binding PauseMenuText}" Click="OnPauseToggle" />
                                                    <MenuItem Header="停止保护" Click="OnStop"
                                                              Foreground="{DynamicResource DangerBrush}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter TargetName="StatusChip" Property="Background"
                                            Value="{DynamicResource SurfaceHoverBrush}" />
                                    <Setter TargetName="StatusLabel" Property="Foreground"
                                            Value="{DynamicResource TextMutedBrush}" />
                                    <Setter TargetName="StatusLabel" Property="Text" Value="已停用" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Enabled}" Value="True" />
                                        <Condition Binding="{Binding Paused}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="StatusChip" Property="Background"
                                            Value="{DynamicResource WarningSubtleBrush}" />
                                    <Setter TargetName="StatusLabel" Property="Foreground"
                                            Value="{DynamicResource WarningBrush}" />
                                    <Setter TargetName="StatusLabel" Property="Text" Value="已暂停" />
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
