<UserControl x:Class="EverDefault.App.RuleEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock x:Name="EditorKindText" Text="编辑规则" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

                <DockPanel Margin="0,3">
                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" />
                </DockPanel>
                <DockPanel x:Name="ActionRow" Margin="0,3">
                    <TextBlock Text="执行动作" Style="{StaticResource FieldLabel}"
                               ToolTip="检测到改动时如何处理：还原 = 写回期望值；删除 = 删除被改的值；仅记录 = 只写日志。" />
                    <ComboBox x:Name="ActionBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                </DockPanel>
                <DockPanel Margin="0,3">
                    <TextBlock Text="监控模式" Style="{StaticResource FieldLabel}"
                               ToolTip="监控：由系统事件触发；定时轮询：按间隔检查；手动：只在点测试时执行。" />
                    <ComboBox x:Name="ModeBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                </DockPanel>
                <DockPanel x:Name="IntervalRow" Margin="0,3">
                    <TextBlock Text="定时轮询(秒)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="IntervalBox" Text="60" />
                </DockPanel>
                <TextBlock x:Name="IntervalHint"
                           Text="提示：定时模式仅在无法使用事件监听时使用；一般保持“监控”即可。"
                           Style="{StaticResource HintText}" Margin="0,4,0,0" />
                <CheckBox x:Name="EnabledBox" Content="启用此规则" IsChecked="True" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <StackPanel x:Name="AppSection">
                            <TextBlock Text="目标应用" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="锁定选定文件类型的默认打开程序。" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                            <DockPanel Margin="0,3">
                                <TextBlock Text="目标应用" Style="{StaticResource FieldLabel}"
                                           ToolTip="这组文件类型要统一使用的应用名称（仅作标识，可留空）。" />
                                <TextBox x:Name="AppNameBox" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="扩展名(逗号分隔)" Style="{StaticResource FieldLabel}" />
                                <Button DockPanel.Dock="Right" Content="选择..." MinWidth="72" Margin="8,0,0,0" Click="OnPickExtension" />
                                <TextBox x:Name="ExtensionsBox" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="URL 协议(逗号分隔)" Style="{StaticResource FieldLabel}"
                                           ToolTip="锁定 URL 协议的默认处理程序，例如 http, https（默认浏览器）或 mailto（邮件客户端）。可只填协议不填扩展名。" />
                                <TextBox x:Name="ProtocolsBox" />
                            </DockPanel>

                            <Expander x:Name="ProgIdAdvanced" Header="高级：手动指定 ProgId" Margin="0,8,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="ProgId" Style="{StaticResource FieldLabel}"
                                                   ToolTip="当该应用为所有扩展名只注册一个 ProgId 时填写；若每个扩展名各有一个 ProgId（如 VLC.mp4 / VLC.mkv），请用规则页的“按分组设置…”自动生成。" />
                                        <Button DockPanel.Dock="Right" Content="选择..." MinWidth="72" Margin="8,0,0,0" Click="OnPickProgId" />
                                        <TextBox x:Name="ProgIdBox" />
                                    </DockPanel>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="协议 ProgId" Style="{StaticResource FieldLabel}"
                                                   ToolTip="上面 URL 协议要使用的 ProgId，例如 ChromeHTML。留空则忽略协议。" />
                                        <Button DockPanel.Dock="Right" Content="选择..." MinWidth="72" Margin="8,0,0,0" Click="OnPickProgId" />
                                        <TextBox x:Name="ProtocolProgIdBox" />
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <CheckBox x:Name="OpenWithBox" Content="同时维护“打开方式”列表" IsChecked="True" Margin="0,6,0,0" />
                            <CheckBox x:Name="FileAssocBox" Content="同时维护传统文件关联(Classes)" IsChecked="True" Margin="0,4,0,0" />
                            <TextBlock x:Name="AppMapHint" Style="{StaticResource HintText}" Margin="0,6,0,0"
                                       Visibility="Collapsed"
                                       Text="该分组按扩展名分别记录 ProgId（例如 .png → BandiView.png）；此处无需填写单一 ProgId。" />
                        </StackPanel>

                        <StackPanel x:Name="NsSection" Visibility="Collapsed">
                            <TextBlock Text="删除目标" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="检测并删除“此电脑/桌面”下的自定义命名空间项。" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                            <DockPanel Margin="0,3">
                                <TextBlock Text="路径(每行一条)" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                                <Button DockPanel.Dock="Right" Content="选择..." MinWidth="72" Margin="8,0,0,0" Click="OnPickNameSpaceKey" />
                                <TextBox x:Name="NsPathsBox" AcceptsReturn="True" Height="56" VerticalScrollBarVisibility="Auto" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="匹配方式" Style="{StaticResource FieldLabel}"
                                           ToolTip="用命名空间的 GUID、显示名称、目标路径或正则来确定要删除的项。" />
                                <ComboBox x:Name="NsMatchTypeBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                            </DockPanel>
                            <DockPanel x:Name="NsPatternRow" Margin="0,3">
                                <TextBlock Text="匹配内容" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="NsPatternBox" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="删除范围" Style="{StaticResource FieldLabel}"
                                           ToolTip="仅命名空间项最安全；同时删除 CLSID 会一并清理对应的 COM 注册信息。" />
                                <ComboBox x:Name="NsScopeBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                            </DockPanel>
                            <CheckBox x:Name="RefreshShellBox" Content="删除后刷新资源管理器(SHChangeNotify)" Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="CustomSection" Visibility="Collapsed">
                            <TextBlock Text="监控目标" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="按基线或期望值监控任意注册表项。" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                            <DockPanel Margin="0,3">
                                <TextBlock Text="键(每行,支持*)" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                                <Button DockPanel.Dock="Right" Content="从注册表选择..." MinWidth="120" Margin="8,0,0,0" Click="OnPickCustomKey" />
                                <TextBox x:Name="KeyPatternsBox" AcceptsReturn="True" Height="56" VerticalScrollBarVisibility="Auto" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="值名(空=默认值)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ValueNameBox" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="匹配方式" Style="{StaticResource FieldLabel}"
                                           ToolTip="任意改动：任何变化都触发；精确匹配：与期望数据完全一致才算正常；包含/正则：按规则判断。" />
                                <ComboBox x:Name="MatchTypeBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="期望类型" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ExpectedKindBox" IsEditable="True"
                                          ToolTip="String / DWord / QWord / MultiString / Binary" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="期望数据(空=用基线)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ExpectedDataBox" />
                            </DockPanel>
                            <DockPanel x:Name="OnMismatchRow" Margin="0,3">
                                <TextBlock Text="检测到改动时" Style="{StaticResource FieldLabel}"
                                           ToolTip="选择这条规则在检测到改动时执行的动作。写策略会把期望值写到下面的策略键。" />
                                <ComboBox x:Name="OnMismatchBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                            </DockPanel>
                            <DockPanel x:Name="PolicyKeyRow" Margin="0,3">
                                <TextBlock Text="策略键" Style="{StaticResource FieldLabel}"
                                           ToolTip="仅“写策略”动作使用：把期望值写到该键，由系统策略强制。例如 HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer。HKCU 会按目标用户展开。" />
                                <TextBox x:Name="PolicyKeyBox" />
                            </DockPanel>
                            <TextBlock Text="“*”匹配子键层：Foo\* 指 Foo 的子键；监控 Foo 自身的值写 Foo（不带 \*）。"
                                       Style="{StaticResource HintText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ScrollViewer>

            <Border x:Name="EmptyState" Style="{StaticResource CardPanel}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
                    <TextBlock Text="未选择规则" Style="{StaticResource SectionHeader}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="从左侧选择一条规则开始编辑，或点击“新建”创建一条。"
                               Style="{StaticResource HintText}" TextAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="FooterPanel" Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource SuccessBrush}"
                           Visibility="Collapsed" TextWrapping="Wrap" />
                <TextBlock x:Name="DirtyText" Text="未保存" Foreground="{DynamicResource WarningBrush}"
                           Visibility="Collapsed" />
                <TextBlock x:Name="ValidationText" Style="{StaticResource DangerText}"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="保存" MinWidth="88" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}" Click="OnSaveClick"
                        AutomationProperties.Name="保存规则" />
                <Button Content="重置" MinWidth="88" Style="{StaticResource SubtleButton}" Click="OnResetClick"
                        AutomationProperties.Name="重置修改" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
