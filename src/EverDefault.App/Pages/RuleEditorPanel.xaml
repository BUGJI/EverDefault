<UserControl x:Class="EverDefault.App.RuleEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardPanel}">
            <StackPanel>
                <DockPanel Margin="0,3">
                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" />
                </DockPanel>
                <DockPanel Margin="0,3">
                    <TextBlock Text="监控模式" Style="{StaticResource FieldLabel}"
                               ToolTip="监控：由系统事件触发；定时轮询：按间隔检查；手动：只在点测试时执行。" />
                    <ComboBox x:Name="ModeBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                </DockPanel>
                <DockPanel Margin="0,3">
                    <TextBlock Text="执行动作" Style="{StaticResource FieldLabel}"
                               ToolTip="检测到改动时如何处理：还原 = 写回期望值；删除 = 删除被改的值；仅记录 = 只写日志。" />
                    <ComboBox x:Name="ActionBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                </DockPanel>
                <DockPanel Margin="0,3">
                    <TextBlock Text="定时轮询(秒)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="IntervalBox" Text="60" />
                </DockPanel>
                <CheckBox x:Name="EnabledBox" Content="启用此规则" IsChecked="True" Margin="0,6,0,0" />
                <TextBlock Text="提示：定时模式仅在无法使用事件监听时使用；一般保持“监控”即可。"
                           Style="{StaticResource HintText}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <StackPanel x:Name="AppSection">
                        <TextBlock Text="锁定选定文件类型的默认打开程序。" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                        <DockPanel Margin="0,3">
                            <TextBlock Text="扩展名(逗号分隔)" Style="{StaticResource FieldLabel}" />
                            <Button DockPanel.Dock="Right" Content="选择..." Width="72" Margin="4,0,0,0" Click="OnPickExtension" />
                            <TextBox x:Name="ExtensionsBox" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="ProgId" Style="{StaticResource FieldLabel}" />
                            <Button DockPanel.Dock="Right" Content="选择..." Width="72" Margin="4,0,0,0" Click="OnPickProgId" />
                            <TextBox x:Name="ProgIdBox" />
                        </DockPanel>
                        <CheckBox x:Name="OpenWithBox" Content="同时维护“打开方式”列表" IsChecked="True" Margin="0,6,0,0" />
                        <CheckBox x:Name="FileAssocBox" Content="同时维护传统文件关联(Classes)" IsChecked="True" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="NsSection" Visibility="Collapsed">
                        <TextBlock Text="检测并删除“此电脑/桌面”下的自定义命名空间项。" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                        <DockPanel Margin="0,3">
                            <TextBlock Text="路径(每行一条)" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                            <Button DockPanel.Dock="Right" Content="选择..." Width="72" Margin="4,0,0,0" Click="OnPickNameSpaceKey" />
                            <TextBox x:Name="NsPathsBox" AcceptsReturn="True" Height="56" VerticalScrollBarVisibility="Auto" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="匹配方式" Style="{StaticResource FieldLabel}"
                                       ToolTip="用命名空间的 GUID、显示名称、目标路径或正则来确定要删除的项。" />
                            <ComboBox x:Name="NsMatchTypeBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="匹配内容" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NsPatternBox" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="删除范围" Style="{StaticResource FieldLabel}"
                                       ToolTip="仅命名空间项最安全；同时删除 CLSID 会一并清理对应的 COM 注册信息。" />
                            <ComboBox x:Name="NsScopeBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                        </DockPanel>
                        <CheckBox x:Name="RefreshShellBox" Content="删除后刷新资源管理器(SHChangeNotify)" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="CustomSection" Visibility="Collapsed">
                        <TextBlock Text="按基线或期望值监控任意注册表项。" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                        <DockPanel Margin="0,3">
                            <TextBlock Text="键(每行,支持*)" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                            <Button DockPanel.Dock="Right" Content="从注册表选择..." Width="120" Margin="4,0,0,0" Click="OnPickCustomKey" />
                            <TextBox x:Name="KeyPatternsBox" AcceptsReturn="True" Height="56" VerticalScrollBarVisibility="Auto" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="值名(空=默认值)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ValueNameBox" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="匹配方式" Style="{StaticResource FieldLabel}"
                                       ToolTip="任意改动：任何变化都触发；精确匹配：与期望数据完全一致才算正常；包含/正则：按规则判断。" />
                            <ComboBox x:Name="MatchTypeBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="期望类型" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ExpectedKindBox" ToolTip="String / DWord / QWord / MultiString / Binary" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="期望数据(空=用基线)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ExpectedDataBox" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="不一致时" Style="{StaticResource FieldLabel}"
                                       ToolTip="仅针对本规则的“期望数据/基线”。未设置期望值时用上面的“执行动作”。" />
                            <ComboBox x:Name="OnMismatchBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                        </DockPanel>
                        <TextBlock Text="“*”匹配子键层：Foo\* 指 Foo 的子键；监控 Foo 自身的值写 Foo（不带 \*）。"
                                   Style="{StaticResource HintText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SaveButton" Content="保存" Width="88" Margin="4,0" Click="OnSaveClick" />
            <Button Content="重置" Width="88" Margin="4,0" Click="OnResetClick" />
        </StackPanel>
    </Grid>
</UserControl>
