<UserControl x:Class="EverDefault.App.RuleModulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EverDefault.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" />
            <TextBlock x:Name="DescText" Style="{StaticResource HintText}" Margin="0,4,0,0" />
            <TextBlock x:Name="EmptyHint" Style="{StaticResource HintText}" Margin="0,4,0,0"
                       Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="NewButton" Content="新建" Width="64" Margin="0,0,6,6" Click="OnNew" />
                    <Button x:Name="DeleteButton" Content="删除" Width="64" Margin="0,0,6,6" Click="OnDelete" />
                    <Button x:Name="TestButton" Content="测试规则" Width="80" Margin="0,0,6,6"
                            Click="OnTestRule"
                            ToolTip="创建一条“仅记录”的示例规则，用于验证监控和日志是否正常。" />
                    <Button x:Name="ImportFormatsButton" Content="导入应用格式..." Width="120"
                            Margin="0,0,6,6" Click="OnImportFormats"
                            ToolTip="选择一个应用，自动为它支持的所有文件类型创建规则。" />
                </WrapPanel>

                <ListBox x:Name="RulesList" SelectionChanged="OnSelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3" ToolTip="{Binding Target}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderSoftBrush}" ResizeBehavior="PreviousAndNext" />

            <local:RuleEditorPanel Grid.Column="2" x:Name="Editor" />
        </Grid>
    </Grid>
</UserControl>
