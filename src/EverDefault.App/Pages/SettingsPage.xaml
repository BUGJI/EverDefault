<UserControl x:Class="EverDefault.App.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="Hint" Style="{StaticResource PageHint}"
                       Text="这些设置保存在后台保护中，修改后点“保存设置”。" />

            <Border x:Name="OfflineBanner" Style="{StaticResource CardPanel}" Margin="0,10,0,0"
                    Background="{DynamicResource WarningSubtleBrush}"
                    BorderBrush="{DynamicResource WarningBrush}" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="启动后台保护" MinWidth="118"
                            Margin="12,0,0,0" Click="OnStartService" />
                    <TextBlock x:Name="OfflineText" Text="后台保护未运行，无法读取或保存设置。"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningBrush}" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="常规" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="MonitoringBox" Content="启用保护" Margin="0,5" />
                    <CheckBox x:Name="StartupBox" Content="随系统启动（开机自启）" Margin="0,5" />
                    <CheckBox x:Name="HideToTrayBox" Content="开机后隐藏到托盘" Margin="26,5,0,5" />
                    <CheckBox x:Name="NotificationsBox" Content="拦截时用气泡通知我" Margin="0,5" />
                    <TextBlock Style="{StaticResource HintText}" Margin="26,0,0,5"
                               Text="关闭后完全静默，但仍会在后台保护并记录。" />

                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="主题" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ThemeBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="更新" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="CheckUpdatesBox" Content="检查版本更新" Margin="0,5" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="检测频率" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="UpdateIntervalBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="CheckNowButton" Content="立即检查更新" MinWidth="112"
                                Click="OnCheckUpdates" />
                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource HintText}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="CurrentVersionText" Style="{StaticResource HintText}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="备份与数据" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="备份会把全部保护项保存为 JSON；恢复是追加导入，不会覆盖已有规则。" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="备份保护..." MinWidth="108" Margin="0,0,8,6" Click="OnBackup" />
                        <Button Content="恢复备份..." MinWidth="108" Margin="0,0,8,6" Click="OnRestore" />
                        <Button Content="打开数据目录" MinWidth="112" Margin="0,0,8,6" Click="OnOpenDataFolder" />
                        <Button x:Name="ClearLogButton" Content="清空活动记录" MinWidth="112"
                                Margin="0,0,8,6" Click="OnClearLog" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Expander Header="高级选项" Margin="0,14,0,0" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSection}">
                <StackPanel Margin="0,8,0,0">
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <CheckBox x:Name="AdvancedModeBox"
                                      Content="显示高级选项（默认应用 / 此电脑 / 自定义注册表）"
                                      Margin="0,2,0,8" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4"
                                       Text="打开后左侧会出现原始规则页，适合需要精确控制注册表的用户。" />

                            <TextBlock Text="运行模式" Style="{StaticResource SectionHeader}" Margin="0,14,0,0" />
                            <TextBlock x:Name="ModeStatusText" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                       Text="用户模式：随登录启动，仅守护当前用户，无需管理员权限。&#10;服务模式：作为 Windows 服务在开机时启动，可守护系统级设置与所有用户；需要管理员权限。" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="InstallServiceButton" Content="安装为服务模式…" MinWidth="158"
                                        Margin="0,0,8,0" Click="OnInstallService" />
                                <Button x:Name="RestartServiceButton" Content="重启服务" MinWidth="90"
                                        Margin="0,0,8,0" Click="OnRestartService" />
                                <Button x:Name="UninstallServiceButton" Content="卸载服务" MinWidth="90"
                                        Click="OnUninstallService" />
                            </StackPanel>
                            <TextBlock x:Name="ModeActionStatus" Style="{StaticResource HintText}" Margin="0,8,0,0" />

                            <DockPanel Margin="0,12,0,0">
                                <TextBlock Text="系统版本覆盖" Style="{StaticResource FieldLabel}"
                                           ToolTip="一般保持“自动检测”。仅在自动识别不准时手动指定。" />
                                <ComboBox x:Name="OsBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                            </DockPanel>

                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="日志保留天数" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RetentionBox" Width="80" HorizontalAlignment="Left" />
                            </DockPanel>

                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="目标用户范围" Style="{StaticResource FieldLabel}"
                                           ToolTip="后台服务以系统身份运行时，规则作用于哪些用户的配置。" />
                                <ComboBox x:Name="UserScopeBox" DisplayMemberPath="Text" SelectedValuePath="Value" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource PrimaryButton}"
                        MinWidth="104" Margin="0,0,8,0" Click="OnSave" />
                <Button Content="重新载入" Style="{StaticResource SubtleButton}" MinWidth="92" Click="OnReload" />
                <TextBlock x:Name="DirtyText" Text="有未保存的修改"
                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                           Margin="12,0,0,0" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
