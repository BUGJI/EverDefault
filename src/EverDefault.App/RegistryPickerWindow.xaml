<Window x:Class="EverDefault.App.RegistryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从注册表选择" Height="540" Width="820"
        MinHeight="360" MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button x:Name="FilterButton" DockPanel.Dock="Right" Content="筛选"
                        Width="56" Margin="4,0,0,0" Click="OnApplyFilter"
                        ToolTip="在当前键下按关键字筛选子键" />
                <TextBox x:Name="FilterBox" KeyDown="OnFilterKeyDown"
                         ToolTip="输入关键字筛选当前键下的子键；留空显示全部。回车或点“筛选”生效。" />
            </DockPanel>
            <TreeView x:Name="Tree"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Standard"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      TreeViewItem.Expanded="OnItemExpanded"
                      SelectedItemChanged="OnTreeSelectionChanged"
                      MouseDoubleClick="OnTreeDoubleClick" />
        </DockPanel>

        <DataGrid Grid.Row="0" Grid.Column="2" x:Name="Values" AutoGenerateColumns="False"
                  IsReadOnly="True" MouseDoubleClick="OnValueDoubleClick" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="{StaticResource AlternatingRowBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="值名" Binding="{Binding Name}" Width="1.5*"
                                    ElementStyle="{StaticResource TrimmingCell}" />
                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="*" />
                <DataGridTextColumn Header="数据" Binding="{Binding Data}" Width="3*"
                                    ElementStyle="{StaticResource TrimmingCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="PathText" Margin="0,8,0,0"
                   TextWrapping="Wrap" FontWeight="Bold" TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="使用此键" Width="90" Margin="4,0" Click="OnUseKey" />
            <Button Content="使用此值" Width="90" Margin="4,0" Click="OnUseValue" />
            <Button Content="取消" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
