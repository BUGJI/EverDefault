<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4C9EE8" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1B1B1D" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF252528" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF202022" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF34343A" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF323236" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#FF2A2A2D" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#FF3A3A3F" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF3F3F45" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE8E8EA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC6C6CA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF9A9AA0" />
    <SolidColorBrush x:Key="NavTextBrush" Color="#FFDDDDE0" />
    <SolidColorBrush x:Key="AlternatingRowBrush" Color="#FF232326" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FF56565C" />

    <!-- Override system colours so native templates (TreeView/DataGrid/ScrollBar) follow the theme. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF252528" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE8E8EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF323236" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFE8E8EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF9A9AA0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF4C9EE8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF10131A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3A3A40" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFE8E8EA" />
</ResourceDictionary>
