<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4C9EE8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6AB0EF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF3B8AD4" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#FF1E3A55" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF74B9F2" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF383838" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#FF262626" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF3F3F3F" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC5C5C5" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="NavTextBrush" Color="#FFD6D6D6" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#FF1E3320" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFCE100" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FF3D3517" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FF3D2024" />

    <SolidColorBrush x:Key="AlternatingRowBrush" Color="#FF262626" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FF56565C" />

    <!-- Override system colours so native templates (TreeView/DataGrid/ScrollBar) follow the theme. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF4C9EE8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF10131A" />
</ResourceDictionary>
